# Copy to .env and fill in. .env is gitignored. Never commit a real key.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: id of a saved agent (create one with `python scripts/create_agent.py`)
# ASSEMBLYAI_AGENT_ID=

# Optional overrides
# ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws
# ASSEMBLYAI_REST_URL=https://agents.assemblyai.com
# VOICE_ID=alba   # the starting English voice. Native voices (lola, estelle, juergen, giovanni, rafael) are chosen automatically per language

# What to do when a learner asks for vulgar phrases: label (teach, flag register) | block
# PROFANITY_POLICY=label

# How long (ms) of silence ends the learner's turn. Lower = snappier replies but more
# risk of cutting off a learner who pauses mid-sentence. Default 700.
# TURN_MIN_SILENCE_MS=700
